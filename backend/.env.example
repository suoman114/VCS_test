# backend/.env.example
# 실제 값을 채운 .env 파일은 절대 커밋하지 않는다 (.gitignore에 이미 포함됨).
# 이 파일은 어떤 환경변수가 필요한지 알려주는 용도로만 키 이름을 나열한다.

# --- App ---
APP_NAME=VCS Test Automation
API_PREFIX=/api
# 콤마로 구분된 허용 Origin 목록 (로컬 개발용 예시)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite로 시작. PostgreSQL로 전환 시 예:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/vcs_test
DATABASE_URL=sqlite:///./storage/db/vcs_test.db

# --- Storage ---
STORAGE_DIR=storage

# --- VCS SSH 접속 정보 (호스트/계정은 배포 환경마다 다름 — 실제 값은 여기(.env)에만 채운다) ---
VCS_SSH_HOST=
VCS_SSH_PORT=22
VCS_SSH_USERNAME=
VCS_SSH_PASSWORD=
VCS_SSH_PRIVATE_KEY_PATH=
# asyncssh known_hosts 파일 경로. 비워두면 known_hosts 검증을 하지 않음(TBD: 운영 환경 확정 필요).
VCS_SSH_KNOWN_HOSTS=

# --- VoLTE(vctp) 경로/명령 — 아래는 확인된 기본값(app/core/config.py와 동일). 배포 환경이
# 다르면만 여기서 override한다. ---
# VCTP_SAMPLE_DIR=/home/vcs/vctp/sample
# VCTP_CONFIG_PATH=/home/vcs/vctp/config/vctp_user.config
# VCTP_STOP_CMD=stopmc -b vctp
# VCTP_START_CMD=startmc -b vctp
# VCS_VCSM_LOG_PATH=/home/vcs/vcsm/logs/vcsm.log
# VCS_VCMM_LOG_PATH=/home/vcs/vcmm/logs/vcmm0.log
# VCS_VCMC_LOG_PATH=/home/vcs/vcmc/logs/vcmc.log

# --- SIPp 실행 대상 (별도 SIPp 전용 호스트를 쓰면 SIPP_EXEC_MODE=ssh로 설정) ---
SIPP_EXEC_MODE=local
SIPP_SSH_HOST=
SIPP_SSH_PORT=22
SIPP_SSH_USERNAME=
SIPP_SSH_PASSWORD=
SIPP_SSH_PRIVATE_KEY_PATH=
# SIPP_REMOTE_WORK_DIR=/tmp/vcs_test_sipp
